model Folder {
  id          String     @id @default(cuid())
  name        String
  description String?
  year        Int
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdById String
  createdBy   User       @relation(fields: [createdById], references: [id])
  documents   Document[]

  @@map("folder")
}